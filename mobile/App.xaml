<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="ManagementSystem.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Colors -->
            <Color x:Key="PrimaryColor">#2F80ED</Color>
            <Color x:Key="SecondaryColor">#10B981</Color>
            <Color x:Key="AccentColor">#8B5CF6</Color>
            <Color x:Key="BackgroundColor">#F9FAFB</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="TextSecondaryColor">#6B7280</Color>
            <Color x:Key="BorderColor">#E5E7EB</Color>
            <Color x:Key="ErrorColor">#DC2626</Color>
            <Color x:Key="SuccessColor">#16A34A</Color>

            <!-- Converters -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter"
                xmlns:local="clr-namespace:ManagementSystem.Mobile.Converters" />

            <!-- Styles -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style TargetType="Frame" x:Key="CardFrame">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style TargetType="Label" x:Key="HeadingLabel">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
            </Style>

            <Style TargetType="Label" x:Key="SubheadingLabel">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
