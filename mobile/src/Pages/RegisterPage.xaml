<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ManagementSystem.Mobile.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create Account"
    BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" Margin="0,20,0,16">
                <Label
                    Text="Create Account"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A" />
                <Label
                    Text="Fill in the details to get started"
                    FontSize="16"
                    TextColor="#6B7280" />
            </VerticalStackLayout>

            <!-- Error Message -->
            <Frame
                BackgroundColor="#FEF2F2"
                BorderColor="#FECACA"
                CornerRadius="8"
                Padding="12"
                IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="#DC2626" FontSize="14" />
            </Frame>

            <!-- First Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="First Name" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                <Frame BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry Text="{Binding FirstName}" Placeholder="John" FontSize="16"
                           TextColor="#1A1A1A" PlaceholderColor="#9CA3AF" Margin="12,8" />
                </Frame>
            </VerticalStackLayout>

            <!-- Last Name -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Last Name" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                <Frame BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry Text="{Binding LastName}" Placeholder="Doe" FontSize="16"
                           TextColor="#1A1A1A" PlaceholderColor="#9CA3AF" Margin="12,8" />
                </Frame>
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Email" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                <Frame BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry Text="{Binding Email}" Placeholder="you@example.com"
                           Keyboard="Email" FontSize="16" TextColor="#1A1A1A"
                           PlaceholderColor="#9CA3AF" Margin="12,8" />
                </Frame>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Password" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                <Frame BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry Text="{Binding Password}" Placeholder="Min. 8 characters"
                           IsPassword="True" FontSize="16" TextColor="#1A1A1A"
                           PlaceholderColor="#9CA3AF" Margin="12,8" />
                </Frame>
            </VerticalStackLayout>

            <!-- Confirm Password -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Confirm Password" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                <Frame BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat password"
                           IsPassword="True" FontSize="16" TextColor="#1A1A1A"
                           PlaceholderColor="#9CA3AF" Margin="12,8" />
                </Frame>
            </VerticalStackLayout>

            <!-- Register Button -->
            <Button
                Text="Create Account"
                Command="{Binding RegisterCommand}"
                BackgroundColor="#2F80ED"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="48"
                Margin="0,8,0,0" />

            <!-- Loading -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#2F80ED"
                HorizontalOptions="Center" />

            <!-- Login Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Already have an account?" TextColor="#6B7280" FontSize="14" />
                <Label Text="Sign in" TextColor="#2F80ED" FontSize="14" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
