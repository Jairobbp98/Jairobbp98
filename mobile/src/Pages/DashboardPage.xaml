<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ManagementSystem.Mobile.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ManagementSystem.Mobile.ViewModels"
    Title="Dashboard"
    BackgroundColor="#F9FAFB">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,16,0">
            <Label
                Grid.Column="0"
                Text="◆ Management System"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#1A1A1A"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="Logout"
                Command="{Binding LogoutCommand}"
                BackgroundColor="Transparent"
                TextColor="#6B7280"
                FontSize="14"
                Padding="8,4" />
        </Grid>
    </Shell.TitleView>

    <RefreshView Command="{Binding LoadDashboardDataCommand}" IsRefreshing="{Binding IsLoading}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Welcome Message -->
                <Label
                    Text="{Binding WelcomeMessage}"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A" />

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                    <!-- Users Card -->
                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="👥" FontSize="28" HorizontalOptions="Center" />
                            <Label
                                Text="{Binding TotalUsers}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#1A1A1A"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Users"
                                FontSize="12"
                                TextColor="#6B7280"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Companies Card -->
                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🏢" FontSize="28" HorizontalOptions="Center" />
                            <Label
                                Text="{Binding TotalCompanies}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#1A1A1A"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Companies"
                                FontSize="12"
                                TextColor="#6B7280"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCompaniesCommand}" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Documents Card -->
                    <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="12" Padding="16" BorderColor="#E5E7EB">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📄" FontSize="28" HorizontalOptions="Center" />
                            <Label
                                Text="{Binding TotalDocuments}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#1A1A1A"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Documents"
                                FontSize="12"
                                TextColor="#6B7280"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToDocumentsCommand}" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <!-- Quick Actions -->
                <Label
                    Text="Quick Actions"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A"
                    Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <Button
                        Grid.Row="0" Grid.Column="0"
                        Text="+ New Document"
                        Command="{Binding NavigateToDocumentsCommand}"
                        BackgroundColor="#2F80ED"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="14"
                        HeightRequest="44" />

                    <Button
                        Grid.Row="0" Grid.Column="1"
                        Text="Manage Users"
                        Command="{Binding NavigateToUsersCommand}"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="14"
                        HeightRequest="44" />

                    <Button
                        Grid.Row="1" Grid.Column="0"
                        Text="Companies"
                        Command="{Binding NavigateToCompaniesCommand}"
                        BackgroundColor="#8B5CF6"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="14"
                        HeightRequest="44" />

                </Grid>

                <!-- Recent Documents -->
                <Label
                    Text="Recent Documents"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#1A1A1A"
                    Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding RecentDocuments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                BackgroundColor="White"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,8"
                                BorderColor="#E5E7EB">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1A1A1A" />
                                        <Label
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            TextColor="#6B7280" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Type}"
                                        FontSize="12"
                                        TextColor="#2F80ED"
                                        VerticalOptions="Center"
                                        BackgroundColor="#EFF6FF"
                                        Padding="8,4" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label
                            Text="No documents yet. Create your first one!"
                            TextColor="#9CA3AF"
                            HorizontalOptions="Center"
                            Margin="0,20" />
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
