<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ManagementSystem.Mobile.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ManagementSystem.Mobile.ViewModels"
    Title="Documents"
    BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto,*">

        <!-- New Document Input Bar -->
        <Frame
            Grid.Row="0"
            BackgroundColor="White"
            BorderColor="#E5E7EB"
            Padding="16,12"
            CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Frame Grid.Column="0" BorderColor="#D1D5DB" CornerRadius="8" Padding="0" BackgroundColor="White">
                    <Entry
                        Text="{Binding NewDocumentTitle}"
                        Placeholder="New document title..."
                        FontSize="15"
                        TextColor="#1A1A1A"
                        PlaceholderColor="#9CA3AF"
                        Margin="12,8" />
                </Frame>
                <Button
                    Grid.Column="1"
                    Text="+"
                    Command="{Binding CreateDocumentCommand}"
                    BackgroundColor="#2F80ED"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    WidthRequest="44"
                    HeightRequest="44" />
            </Grid>
        </Frame>

        <!-- Documents List -->
        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadDocumentsCommand}"
            IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Documents}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        Text="PDF"
                                        BackgroundColor="#EF4444"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ExportAsPdfCommand}"
                                        CommandParameter="{Binding .}" />
                                    <SwipeItem
                                        Text="MD"
                                        BackgroundColor="#8B5CF6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ExportAsMarkdownCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame
                                BackgroundColor="White"
                                CornerRadius="0"
                                Padding="16"
                                Margin="0,0,0,1"
                                BorderColor="#F3F4F6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                    <Label
                                        Grid.Row="0" Grid.Column="0"
                                        Text="{Binding Title}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#1A1A1A" />

                                    <Label
                                        Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Type}"
                                        FontSize="11"
                                        TextColor="#2F80ED"
                                        BackgroundColor="#EFF6FF"
                                        Padding="6,2"
                                        VerticalOptions="Center" />

                                    <HorizontalStackLayout
                                        Grid.Row="1" Grid.Column="0"
                                        Spacing="8"
                                        Margin="0,4,0,0">
                                        <Label
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            TextColor="#6B7280" />
                                        <Label
                                            Text="·"
                                            FontSize="12"
                                            TextColor="#9CA3AF" />
                                        <Label
                                            Text="{Binding UpdatedAt, StringFormat='{0:MMM dd, yyyy}'}"
                                            FontSize="12"
                                            TextColor="#9CA3AF" />
                                    </HorizontalStackLayout>

                                </Grid>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ViewDocumentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Margin="40">
                        <Label Text="📄" FontSize="64" HorizontalOptions="Center" />
                        <Label
                            Text="No documents yet"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#374151"
                            HorizontalOptions="Center" />
                        <Label
                            Text="Type a title above and press + to create your first document"
                            FontSize="14"
                            TextColor="#6B7280"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
